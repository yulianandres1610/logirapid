# Auto.dev API - VIN Decode y Vehicle Photos
NEXT_PUBLIC_AUTO_DEV_API_KEY=your_auto_dev_api_key_here

# NextAuth Configuration
NEXTAUTH_URL=https://your-domain.vercel.app
NEXTAUTH_SECRET=your_nextauth_secret_here

# Mapbox Configuration
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# PostgreSQL Database Configuration (Supabase)
DATABASE_URL=postgresql://user:password@host:5432/database

# Supabase PostgreSQL Credentials
DB_HOST=your_supabase_host
DB_PORT=5432
DB_NAME=postgres
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SSL=true

# Supabase Client Credentials (API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================
# PAYMENT GATEWAY CREDENTIALS (Platform Level)
# ============================================
# These are LogiRapid platform credentials used for wallet recharges
# Company-level credentials are stored in the database

# Square Platform Credentials
# Get these from: https://developer.squareup.com/apps
SQUARE_PLATFORM_ACCESS_TOKEN=your_square_access_token_here
SQUARE_PLATFORM_APPLICATION_ID=your_square_application_id_here
SQUARE_PLATFORM_LOCATION_ID=your_square_location_id_here
SQUARE_PLATFORM_ENVIRONMENT=sandbox

# Stripe Platform Credentials
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_PLATFORM_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PLATFORM_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_PLATFORM_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ============================================
# APACARGO INTEGRATION (Shipping to Cuba)
# ============================================
# ApaCargo API credentials for office orders synchronization
# Contact ApaCargo for credentials
APACARGO_API_URL=https://dev-apacargo-api.azurewebsites.net
APACARGO_USERNAME=your_apacargo_username
APACARGO_PASSWORD=your_apacargo_password
APACARGO_AGENCY_ID=your_agency_id

# ============================================
# WHATSAPP/VOICE AGENT CONFIGURATION
# ============================================
# OpenAI API key for WhatsApp agent conversations
OPENAI_API_KEY=your_openai_api_key_here

# Company name for WhatsApp/Voice agent orders
# Must match the company name in the companies table
WHATSAPP_AGENT_COMPANY_NAME=LogiRapid LLC

# Twilio credentials for SMS/WhatsApp/Voice
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+1234567890

# ============================================
# OPENAI REALTIME SIP INTEGRATION
# ============================================
# Webhook secret for verifying OpenAI SIP webhook requests
# Get this from: https://platform.openai.com/settings → Webhooks
OPENAI_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# OpenAI Project ID for SIP routing
# Get this from: https://platform.openai.com/settings → Project → General
OPENAI_PROJECT_ID=proj_your_project_id_here
